{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topaz-viewers-sync",
  // 共有の Cloudflare アカウント。ログイン中のユーザーが複数のアカウントに入れても、ここにデプロイされる
  "account_id": "4cb63c07301191454485637a2e64c531",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "topaz-viewers-sync",
      "database_id": "ef3f7108-2760-4c5d-9eff-908d2e20085d",
      "migrations_dir": "migrations"
    }
  ],
  // SPEC 7.4 の設定値。コードを変えずにここ（または wrangler dev --var）で差し替える
  "vars": {
    "MAX_NAME_LENGTH": "32",
    "RATE_LIMIT_PER_HOUR": "10"
  },
  // NGワードの一覧（JSON の文字列配列）、書き出し用の合言葉、接続元を変換する鍵。リポジトリが公開なのでシークレットで渡す。
  // ローカルは .dev.vars、本番は wrangler secret put で設定する
  "secrets": {
    "required": ["NG_WORDS", "EXPORT_TOKEN", "IP_HASH_KEY"]
  }
}
